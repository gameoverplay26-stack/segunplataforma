{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/docs/00-discovery/**)",

      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",

      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete --force *)",
      "Bash(git clean *)",

      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout * -- *)",
      "PowerShell(git checkout .)",
      "PowerShell(git restore *)",
      "PowerShell(git tag -d *)",
      "PowerShell(git tag --delete *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch --delete --force *)",
      "PowerShell(git clean *)"
    ]
  }
}
